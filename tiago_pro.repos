---
repositories:
  vcs_tiago_pro/play_motion2:
    type: git
    url: https://github.com/pal-robotics/play_motion2.git
    version: 1.8.6

  vcs_tiago_pro/pal_sea_arm_moveit_config:
    type: git
    url: https://github.com/clementPene/pal_sea_arm_moveit_config.git
    version: humble-devel

  vcs_tiago_pro/tiago_pro_moveit_config:
    type: git
    url: https://github.com/clementPene/tiago_pro_moveit_config.git
    version: humble-devel

  vcs_tiago_pro/pal_atc:
    type: git
    url: https://github.com/clementPene/pal_atc.git
    version: humble-devel

  vcs_tiago_pro/pal_gazebo_worlds:
    type: git
    url: https://github.com/pal-robotics/pal_gazebo_worlds.git
    version: 4.14.1

  vcs_tiago_pro/pal_urdf_utils:
    type: git
    url: https://github.com/pal-robotics/pal_urdf_utils.git
    version: 2.9.2

  vcs_tiago_pro/tiago_pro_head_robot:
    type: git
    url: https://github.com/pal-robotics/tiago_pro_head_robot.git
    version: 1.12.0

  vcs_tiago_pro/pal_pro_gripper:
    type: git
    url: https://github.com/pal-robotics/pal_pro_gripper.git
    version: 1.12.5

  vcs_tiago_pro/omni_base_robot:
    type: git
    url: https://github.com/pal-robotics/omni_base_robot.git
    version: 2.17.0

  vcs_tiago_pro/pal_sea_arm:
    type: git
    url: https://github.com/clementPene/pal_sea_arm.git
    version: humble-devel

  vcs_tiago_pro/tiago_pro_robot:
    type: git
    url: https://github.com/clementPene/tiago_pro_robot.git
    version: humble-devel

  vcs_tiago_pro/tiago_pro_simulation:
    type: git
    url: https://github.com/clementPene/tiago_pro_simulation.git
    version: humble-devel

  vcs_tiago_pro/launch_pal:
    type: git
    url: https://github.com/pal-robotics/launch_pal.git
    version: 0.21.1

  # ros2_control stack pinned to match pal-alum-* versions running on tiago-pro-25c
  # (PAL backports a newer ros2_control onto their Humble-based "alum" distro;
  # the apt ros-humble-* packages are older and cause ABI mismatches / garbled
  # `ros2 control list_controllers` output when talking to the robot).
  # Check the robot's actual versions with:
  #   ssh pal@tiago-pro-25c "dpkg -l | grep -iE 'pal-alum-(controller-manager|ros2-controllers|realtime-tools|control-toolbox|control-msgs|kinematics-interface) '"
  vcs_tiago_pro/ros2_control:
    type: git
    url: https://github.com/ros-controls/ros2_control.git
    version: 4.46.0

  vcs_tiago_pro/ros2_controllers:
    type: git
    url: https://github.com/ros-controls/ros2_controllers.git
    version: 4.40.1

  vcs_tiago_pro/realtime_tools:
    type: git
    url: https://github.com/ros-controls/realtime_tools.git
    version: 4.6.0

  vcs_tiago_pro/control_toolbox:
    type: git
    url: https://github.com/ros-controls/control_toolbox.git
    version: 4.9.0

  vcs_tiago_pro/control_msgs:
    type: git
    url: https://github.com/ros-controls/control_msgs.git
    version: 5.7.0

  vcs_tiago_pro/kinematics_interface:
    type: git
    url: https://github.com/ros-controls/kinematics_interface.git
    version: 1.6.0
