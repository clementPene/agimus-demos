<?xml version="1.0" encoding="utf-8"?>
<!-- Table with top surface at z = 0.745 m (74.5 cm height). -->
<robot name="table">

  <material name="table_white">
    <color rgba="0.75 0.75 0.7 1.0"/>
  </material>
  <material name="table_gray">
    <color rgba="0.5 0.5 0.5 1.0"/>
  </material>

  <!-- Virtual root -->
  <link name="base_link"/>

  <!-- Table top: 1.0 x 2.0 x 0.025 m, joint places link centre at 0.7325 m
       -> top surface at 0.7325 + 0.0125 = 0.745 m -->
  <joint name="table_top_joint" type="fixed">
    <parent link="base_link"/>
    <child link="table_top_link"/>
    <origin xyz="0 0 0.7325" rpy="0 0 0"/>
  </joint>
  <link name="table_top_link">
    <visual>
      <geometry>
        <box size="1.0 2.0 0.025"/>
      </geometry>
      <material name="table_white"/>
    </visual>
    <collision>
      <geometry>
        <box size="1.0 2.0 0.025"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="5.0"/>
      <inertia ixx="0.1" ixy="0" ixz="0" iyy="0.1" iyz="0" izz="0.1"/>
    </inertial>
  </link>

  <!-- Legs: 0.720 m tall, centred at z = 0.360 m -->
  <joint name="leg_fl_joint" type="fixed">
    <parent link="base_link"/>
    <child link="leg_fl_link"/>
    <origin xyz=" 0.475  0.975 0.360" rpy="0 0 0"/>
  </joint>
  <link name="leg_fl_link">
    <visual>
      <geometry><cylinder length="0.720" radius="0.025"/></geometry>
      <material name="table_gray"/>
    </visual>
    <collision>
      <geometry><cylinder length="0.720" radius="0.025"/></geometry>
    </collision>
    <inertial>
      <mass value="1.0"/>
      <inertia ixx="0.04" ixy="0" ixz="0" iyy="0.04" iyz="0" izz="0.0003"/>
    </inertial>
  </link>

  <joint name="leg_fr_joint" type="fixed">
    <parent link="base_link"/>
    <child link="leg_fr_link"/>
    <origin xyz=" 0.475 -0.975 0.360" rpy="0 0 0"/>
  </joint>
  <link name="leg_fr_link">
    <visual>
      <geometry><cylinder length="0.720" radius="0.025"/></geometry>
      <material name="table_gray"/>
    </visual>
    <collision>
      <geometry><cylinder length="0.720" radius="0.025"/></geometry>
    </collision>
    <inertial>
      <mass value="1.0"/>
      <inertia ixx="0.04" ixy="0" ixz="0" iyy="0.04" iyz="0" izz="0.0003"/>
    </inertial>
  </link>

  <joint name="leg_rl_joint" type="fixed">
    <parent link="base_link"/>
    <child link="leg_rl_link"/>
    <origin xyz="-0.475  0.975 0.360" rpy="0 0 0"/>
  </joint>
  <link name="leg_rl_link">
    <visual>
      <geometry><cylinder length="0.720" radius="0.025"/></geometry>
      <material name="table_gray"/>
    </visual>
    <collision>
      <geometry><cylinder length="0.720" radius="0.025"/></geometry>
    </collision>
    <inertial>
      <mass value="1.0"/>
      <inertia ixx="0.04" ixy="0" ixz="0" iyy="0.04" iyz="0" izz="0.0003"/>
    </inertial>
  </link>

  <joint name="leg_rr_joint" type="fixed">
    <parent link="base_link"/>
    <child link="leg_rr_link"/>
    <origin xyz="-0.475 -0.975 0.360" rpy="0 0 0"/>
  </joint>
  <link name="leg_rr_link">
    <visual>
      <geometry><cylinder length="0.720" radius="0.025"/></geometry>
      <material name="table_gray"/>
    </visual>
    <collision>
      <geometry><cylinder length="0.720" radius="0.025"/></geometry>
    </collision>
    <inertial>
      <mass value="1.0"/>
      <inertia ixx="0.04" ixy="0" ixz="0" iyy="0.04" iyz="0" izz="0.0003"/>
    </inertial>
  </link>

</robot>
